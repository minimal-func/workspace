<footer class="footer-7 text-center-xs  ">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="type--fine-print">&copy;
                    <span class="update-year"></span> Made by <a href="https://ildarsafin.tech" target="_blank">Ildar Safin</a></span>
            </div>
            <div class="col-md-6 d-flex flex-column flex-md-row justify-content-center justify-content-md-end align-items-md-center">
                <ul class="social-list list-inline mb-0 me-md-4">
                    <li>
                        <a href="https://github.com/ildarsafin" target="_blank">
                            <i class="socicon socicon-github icon icon--xs"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://twitter.com/ildaronrails" target="_blank">
                            <i class="socicon socicon-twitter icon icon--xs"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://facebook.com/wsafild" target="_blank">
                            <i class="socicon socicon-facebook icon icon--xs"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://instagram.com/ildar.safin" target="_blank">
                            <i class="socicon socicon-instagram icon icon--xs"></i>
                        </a>
                    </li>
                </ul>
                <div class="footer-actions d-flex justify-content-center align-items-center gap-2">
                  <%= link_to help_path, class: "btn btn--sm btn-outline-secondary type--uppercase" do %>
                    <span class="btn__text">Help</span>
                  <% end %>
                  <%= link_to landing_path(anchor: "support"), class: "btn btn--sm btn--primary type--uppercase" do %>
                    <span class="btn__text">
                        <i class="icon icon-Coffee"></i> Support MyDay
                    </span>
