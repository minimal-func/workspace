.knowledge-hub

  .knowledge-hero.shadow-sm.mb-4
    .row.align-items-center
      .col-lg-8
        span.knowledge-eyebrow Second Brain 2.0
        h2.knowledge-title Your accumulated wisdom
        p.knowledge-subtitle
          | People try to organize their lives. They build systems, abandon them, then return with a new version.
          | This is not about tools — it is about an unmet human need for control, clarity, and memory.
          br
          em.text-muted Everything you have captured lives here. One unified field.
      .col-lg-4.text-center
        = render "application/mascot", size: :small, css_class: "knowledge-mascot", title: "Sunny, organizing your knowledge", action: :organize

  .row.mb-4.g-3
    .col-md-3
      .knowledge-stat-card
        .knowledge-stat-icon
          i.icon-Pen
        .knowledge-stat-body
          .knowledge-stat-value= @stats[:total_entries]
          .knowledge-stat-label Total knowledge entries
    .col-md-3
      .knowledge-stat-card
        .knowledge-stat-icon
          i.icon-Heart
        .knowledge-stat-body
          .knowledge-stat-value= @stats[:gratitude_count]
          .knowledge-stat-label Gratitudes logged
    .col-md-3
      .knowledge-stat-card
        .knowledge-stat-icon
          i.icon-Light-Bulb
        .knowledge-stat-body
          .knowledge-stat-value= @stats[:lesson_count]
          .knowledge-stat-label Lessons captured
    .col-md-3
      .knowledge-stat-card
        .knowledge-stat-icon
          i.icon-Calendar
        .knowledge-stat-body
          .knowledge-stat-value= @stats[:record_days]
          .knowledge-stat-label Days with entries

  .row.mb-4
    .col-12
      .knowledge-search-card
        = form_tag search_knowledge_index_path, method: :post, remote: true, class: "knowledge-search-form", id: "knowledge-search-form" do
          .input-group
            .input-group-prepend
              span.input-group-text.bg-transparent.border-0
                i.icon-Search
            = text_field_tag :query, params[:query], placeholder: "Search across all your knowledge — reflections, lessons, links, notes...", class: "form-control knowledge-search-input", autocomplete: "off"
            .input-group-append
              button.btn.btn-knowledge-search type="submit" Search
        #knowledge-search-results

  .row
    .col-lg-8
      .card.shadow-sm.knowledge-stream-card
        .card-header.bg-white.py-3.d-flex.justify-content-between.align-items-center
          h5.mb-0 Knowledge stream
          span.badge.badge-light = @recent_items.size
        .card-body.p-0
          - if @recent_items.any?
            - @recent_items.each do |item|
              a.knowledge-stream-item href=item[:path]
                .knowledge-stream-icon class="knowledge-icon--#{item[:type]}"
                  i class=item[:icon]
                .knowledge-stream-content
                  .knowledge-stream-header
                    span.knowledge-stream-type = item[:title]
                    span.knowledge-stream-date = time_ago_in_words(item[:date]) + " ago"
                  .knowledge-stream-preview = item[:preview]
          - else
            .text-center.py-5
              p.text-muted.mb-0 Your knowledge garden is empty. Start capturing your days to grow it.

    .col-lg-4
      - if @ai_insight
        .card.shadow-sm.knowledge-insight-card.mb-4
          .card-body
            .d-flex.align-items-center.mb-3
              .knowledge-insight-icon
                i.icon-Light-Bulb
              .ms-3
                h6.mb-0 = @ai_insight[:title]
                small.text-muted AI insight
            p.knowledge-insight-message = @ai_insight[:message]

      .card.shadow-sm
        .card-header.bg-white.py-3
          h5.mb-0 Explore your garden
        .card-body.p-3
          .list-group.list-group-flush
            = link_to reflections_path, class: "list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 px-2"
              .knowledge-nav-icon style="background: #e3f2fd;"
                i.icon-Pen.text-primary
              div
                strong Reflections
                small.d-block.text-muted Your daily thoughts
            = link_to daily_gratitudes_path, class: "list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 px-2"
              .knowledge-nav-icon style="background: #fce4ec;"
                i.icon-Heart.text-danger
              div
                strong Gratitudes
                small.d-block.text-muted What you are thankful for
            = link_to daily_lessons_path, class: "list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 px-2"
              .knowledge-nav-icon style="background: #fff3e0;"
                i.icon-Light-Bulb.text-warning
              div
                strong Lessons
                small.d-block.text-muted What life taught you
            = link_to biggest_challenges_path, class: "list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 px-2"
              .knowledge-nav-icon style="background: #f3e5f5;"
                i.icon-Flag.text-secondary
              div
                strong Challenges
                small.d-block.text-muted What you overcame
            - if current_user.projects.any?
              hr.my-2
              h6.text-muted.px-2.mb-2 Projects
              - current_user.projects.where(closed: false).each do |project|
                = link_to project_posts_path(project), class: "list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 px-2"
                  .knowledge-nav-icon style="background: #e8f5e9;"
                    i.icon-Newspaper.text-success
                  div
                    strong = project.title
                    small.d-block.text-muted Posts & notes
